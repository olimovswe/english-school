# Faqat lokal ishlab chiqish uchun. Nusxa oling: cp .env.example .env
# Keyin POSTGRES_PASSWORD ni almashtiring (masalan: openssl rand -hex 24) va scripts/dev-secrets.sh ni
# ishga tushiring: u connection string'ni user-secrets'ga yozadi, parol appsettings va git'ga tushmaydi.
POSTGRES_DB=english_school
POSTGRES_USER=english_school
POSTGRES_PASSWORD=change-me
# 5432 koʻpincha lokal oʻrnatilgan PostgreSQL bilan band boʻladi.
POSTGRES_PORT=5434
REDIS_PORT=6379
