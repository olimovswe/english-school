# Faqat lokal ishlab chiqish uchun. Nusxa oling: cp .env.example .env
# Keyin POSTGRES_PASSWORD ni almashtiring (masalan: openssl rand -hex 24) va scripts/dev-secrets.sh ni
# ishga tushiring: u connection string'ni user-secrets'ga yozadi, parol appsettings va git'ga tushmaydi.
POSTGRES_DB=english_school
POSTGRES_USER=english_school
POSTGRES_PASSWORD=change-me
# 5432 koʻpincha lokal oʻrnatilgan PostgreSQL bilan band boʻladi.
POSTGRES_PORT=5434
REDIS_PORT=6379
# Ixtiyoriy: OpenAI (yoki OpenAI Audio API bilan mos server) kaliti — Whisper va TTS. Boʻsh boʻlsa talaffuz bahosi va
# namuna talaffuz kliplari oʻchiq.
SPEECH_API_KEY=

# --- Production: docker compose --profile app up -d --build ---------------------------------------------------
# JWT imzo kaliti, kamida 32 bayt: openssl rand -base64 48. Boʻsh boʻlsa API ishga tushmaydi.
JWT_SIGNING_KEY=
# Brauzer ilovalari manzillari, vergul bilan (https://app.example.uz,https://admin.example.uz). Boʻsh — hech biri.
CORS_ALLOWED_ORIGINS=
# API porti. 127.0.0.1 — faqat shu serverdagi reverse proxy (TLS) uchun; tashqariga ochish: API_BIND=0.0.0.0
API_BIND=127.0.0.1
API_PORT=8080
# API faqat reverse proxy orqali ochiq boʻlsa true: haqiqiy mijoz IP'si X-Forwarded-For'dan olinadi.
FORWARDED_HEADERS_ENABLED=false
# Daqiqasiga soʻrovlar: umumiy (foydalanuvchi boʻyicha), kirish (IP boʻyicha), talaffuz bahosi (foydalanuvchi boʻyicha).
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SPEECH_PER_MINUTE=20
# Ixtiyoriy: @BotFather tokeni; boʻsh boʻlsa Telegram orqali kirish 503.
TELEGRAM_BOT_TOKEN=
# Image tegi (english-school-api:<tag>, english-school-worker:<tag>).
APP_VERSION=local
