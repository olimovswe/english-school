# Lokal sozlamalar: cp .env.example .env.local (git'ga tushmaydi). Hammasi ixtiyoriy.

# Backend API: Next.js /api/v1/* soʻrovlarini shu manzilga uzatadi.
# dotnet run --project src/Host.Api → http://localhost:5080; docker compose --profile app → http://localhost:8080
API_PROXY_TARGET=http://localhost:5080

# Brauzer API'ga qaysi manzil orqali murojaat qiladi. Odatda /api/v1 (yuqoridagi proksi orqali, CORS kerak emas).
# Toʻliq manzil (https://api.example.uz/api/v1) berilsa, u API'ning Cors:AllowedOrigins roʻyxatida boʻlishi kerak.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Telegram Login Widget boti, @ belgisisiz. Bot tokeni esa faqat API'da (TELEGRAM_BOT_TOKEN).
# BotFather'da /setdomain bilan sayt domeni koʻrsatiladi; widget localhost'da ishlamaydi.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
