{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Hosting": {
    "ShutdownTimeout": "00:00:25"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitsPerMinute": 300,
    "AuthenticationPermitsPerMinute": 20,
    "SpeechPermitsPerMinute": 20
  },
  "Curriculum": {
    "ActiveCourseVersion": 1,
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Practice": {
    "ActiveCourseVersion": 1,
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": false
  },
  "Retention": {
    "ApplyMigrationsOnStartup": false,
    "DesiredRetention": 0.9,
    "MaximumIntervalDays": 365
  },
  "Discipline": {
    "ApplyMigrationsOnStartup": false
  },
  "Analytics": {
    "ApplyMigrationsOnStartup": false
  },
  "Speech": {
    "ApplyMigrationsOnStartup": false,
    "StoragePath": "App_Data/audio",
    "MaxRecordingBytes": 5242880,
    "DailyAssessmentLimit": 100,
    "Provider": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ApiKey": "",
      "TranscriptionModel": "whisper-1",
      "SynthesisModel": "tts-1",
      "Voice": "alloy",
      "Speed": 0.9,
      "Timeout": "00:00:30"
    }
  },
  "Identity": {
    "ApplyMigrationsOnStartup": false,
    "DefaultTimeZone": "Asia/Tashkent",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:05:00",
    "Jwt": {
      "Issuer": "english-school",
      "Audience": "english-school",
      "SigningKey": "",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00"
    },
    "Telegram": {
      "BotToken": "",
      "MaxAuthAge": "00:10:00"
    }
  }
}
