      "SynthesisModel": "tts-1",
      "Voice": "alloy",
      "Speed": 0.9,
      "Timeout": "00:00:30"
    }
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}
